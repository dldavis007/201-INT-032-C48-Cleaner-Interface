 0001           ; // Table with SDO Responses for read requests to OD
 0001           ; // Each Row has 8 Bytes:
 0001           ; // Command Specifier for SDO Response (1 byte)
 0001           ; //   bits 2+3 contain: '4' � {number of data bytes}
 0001           ; // Object Dictionary Index (2 bytes, low first)
 0001           ; // Object Dictionary Subindex (1 byte)
 0001           ; // Data (4 bytes, lowest bytes first)
 0001           ; UNSIGNED8 MEM_CONST SDOResponseTable[] = {
 0001           ; 
 0001           ;   // [1000h,00]: Device Type
 0001           ;   SDOREPLY(0x1000, 0x00, 4, OD_DEVICE_TYPE),
 0001           ; 
 0001           ; #ifdef OD_SERIAL
 0001           ;   // [1018h,00]: Identity Object, Number of Entries = 4
 0001           ;   SDOREPLY(0x1018, 0x00, 1, 0x00000004L),
 0001           ; #else
 0001           ;   // [1018h,00]: Identity Object, Number of Entries = 3
 0001           ;   SDOREPLY(0x1018, 0x00, 1, 0x00000003L),
 0001           ; #endif
 0001           ; 
 0001           ;   // [1018h,01]: Identity Object, Vendor ID
 0001           ;   SDOREPLY(0x1018, 0x01, 4, OD_VENDOR_ID),
 0001           ; 
 0001           ;   // [1018h,02]: Identity Object, Product Code
 0001           ;   SDOREPLY(0x1018, 0x02, 4, OD_PRODUCT_CODE),
 0001           ; 
 0001           ;   // [1018h,03]: Identity Object, Revision
 0001           ;   SDOREPLY(0x1018, 0x03, 4, OD_REVISION),
 0001           ; 
 0001           ; #ifdef OD_SERIAL
 0001           ;   // [1018h,04]: Identity Object, Serial
 0001           ;   SDOREPLY(0x1018, 0x04, 4, OD_SERIAL),
 0001           ; #endif
 0001           ; 
 0001           ;   // [2018h,00]: MicroCANopen Identity Object, Number of Entries = 3
 0001           ;   SDOREPLY(0x2018, 0x00, 1, 0x00000003L),
 0001           ; 
 0001           ;   // [2018h,01]: MicroCANopen Identity Object, Vendor ID = 01455341, ESA Inc.
 0001           ;   SDOREPLY(0x2018, 0x01, 4, 0x01455341L),
 0001           ; 
 0001           ;   // [2018h,02]: MicroCANopen Identity Object, Product Code = "MCOP"
 0001           ;   SDOREPLY4(0x2018, 0x02, 4, 'P', 'O', 'C', 'M'),
 0001           ; 
 0001           ;   // [2018h,03]: MicroCANopen Identity Object, Revision = 1.20
 0001           ;   SDOREPLY(0x2018, 0x03, 4, 0x00010020L),
 0001           ; 
 0001           ;   // [2100h,00]: MicroCANopen Identity Object, Number of Entries = 3
 0001           ;   SDOREPLY(0x2100, 0x00, 1, 0x00000004L),
 0001           ; 
 0001           ;   // [2100h,01]: MicroCANopen Identity Object, Vendor ID = 01455341, ESA Inc.
 0001           ;   SDOREPLY4(0x2100, 0x01, 4, 'C', 'L', 'E', 'A'),
 0001           ; 
 0001           ;   // [2100h,02]: MicroCANopen Identity Object, Product Code = "MCOP"
 0001           ;   SDOREPLY4(0x2100, 0x02, 4, 'N', 'E', 'R', '-'),
 0001           ; 
 0001           ;   // [2100h,03]: MicroCANopen Identity Object, Revision = 1.20
 0001           ;   SDOREPLY4(0x2100, 0x03, 4, 'V', 'A', 'C', 'U'),
 0001           ; 
 0001           ;   // [2100h,04]: MicroCANopen Identity Object, Revision = 1.20
 0001           ;   SDOREPLY4(0x2100, 0x04, 4, 'U', 'M', ' ', 0x32),
 0001           ; 
 0001           ; #ifdef PDO_IN_OD
 0001           ;   // NOTE: These entries must be added manually. The parameters must match
