 0382           ; #include "stdarg.h"
 0382           ; UNSIGNED8 setFilters[8] = {0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80};
 0382           ; /**************************************************************************
 0382           ; DOES:    Initializes the next available filter                    
 0382           ; RETURNS: 0 for failed init, 1 for successful init
 0382           ;  
 0382           ; This function replaces the original function that just
 0382           ; set up to 8 filters, requiring a match of all bits.
 0382           ; This function can be called as previously with just
 0382           ; the CANID argument and it will function as it previously
 0382           ; was intended.
 0382           ;  
 0382           ; This function keeps track of all filters that have been set.
 0382           ; If the address (last 7 bits in CANID as defined by 'bin'
 0382           ; after applying the mask to the CANID) in a given CANID corresponds
 0382           ; to a set filter (kept in global variable list setFilters; declared
 0382           ; in mcohw.c), no filter is set. Otherwise, the filter is set,
 0382           ; the filter is added to setFilters, gCANFilter is incremented
 0382           ; and 1 (success) is returned
 0382           ;  
 0382           ; The call to this function in "MCO_Init" that sets the filter
 0382           ; for the NMT master does not need modified, should look like
 0382           ; the following: ("if (!MCOHW_SetCANFilter(0))")
 0382           ;  
 0382           ; The call to this function in "MCO_Init" that sets the filter
 0382           ; to accept SDO for this node, should look like the following
 0382           ; (such as; "if (!MCOHW_SetCANFilter(0x600+Node_ID))"
 0382           ;                  
