{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PC-Side: Build & Run",
            "type": "shell",
            "command": "mingw32-make run",
            "options": { "cwd": "${workspaceFolder}/pc_side" },
            "group": "test",
            "problemMatcher": [],
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated" },
            "detail": "Builds and runs the cleaner-interface PC host with simulated RTI and UDP CAN."
        },
        {
            "label": "Test: Cleaner PC Regression",
            "type": "shell",
            "command": "python run_tests.py",
            "options": { "cwd": "${workspaceFolder}/tests" },
            "group": "test",
            "problemMatcher": [],
            "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated" },
            "detail": "Builds the host and runs cleaner CAN, menu, startup, and crash-regression tests."
        },
        {
            "label": "PC-SIDE: Tests, Build & Run",
            "dependsOrder": "sequence",
            "dependsOn": ["Test: Cleaner PC Regression", "PC-Side: Build & Run"],
            "group": { "kind": "build", "isDefault": false },
            "problemMatcher": [],
            "detail": "Runs every cleaner PC regression test, then starts the host only if they pass."
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/build.bat",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" },
            "detail": "Runs the embedded project build process.",
            "options": { "cwd": "${workspaceFolder}/.vscode" }
        },
        {
            "label": "VSConvert Task",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/vsconvert.bat",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" },
            "detail": "Organizes project files and modifies .src file.",
            "options": { "cwd": "${workspaceFolder}/.vscode" }
        }
    ]
}
